{
  "entity": "Usuario",
  "description": "Representa a los usuarios registrados de la aplicación KERA.",
  "fields": [
    {
      "name": "nombre",
      "type": "String",
      "required": true
    },
    {
      "name": "apellidos",
      "type": "String",
      "required": false
    },
    {
      "name": "email",
      "type": "String",
      "required": true,
      "unique": true
    },
    {
      "name": "password",
      "type": "String",
      "required": true
    },
    {
      "name": "rol",
      "type": "String",
      "required": true,
      "default": "customer",
      "enum": ["customer", "admin"]
    },
    {
      "name": "telefono",
      "type": "String",
      "required": false
    },
    {
      "name": "direccion",
      "type": "String",
      "required": false
    }
  ]
}